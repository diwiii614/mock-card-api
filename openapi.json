            "description": "Send as x-step-up-token on the next change. Single use."
          },
          "expires_in_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires In Minutes"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
