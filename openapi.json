        "tags": [
          "EMI"
        ],
        "summary": "Convert the current bill to EMI",
        "description": "Use after the customer has picked a tenure from get_emi_options and confirmed the rate and the processing fee. Needs step up verification. Returns a reference for the customer.",
        "operationId": "convert_bill_to_emi",
        "parameters": [
          {
            "name": "x-session-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
