              "description": "Session token from verify_otp",
              "title": "X-Session-Token"
            },
            "description": "Session token from verify_otp"
          },
          {
            "name": "x-step-up-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Single use token from verify_step_up",
              "title": "X-Step-Up-Token"
            },
            "description": "Single use token from verify_step_up"
