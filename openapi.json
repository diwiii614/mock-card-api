    "/card/emi-options": {
      "get": {
        "tags": [
          "EMI"
        ],
        "summary": "List EMI plans available on the current bill",
        "description": "Use when the customer says the bill is too large to pay at once, or asks about instalments. Returns the tenures available and the annual interest rate on each, plus the one time processing fee. Read only, nothing is committed. Read the options out so the customer can pick a tenure.",
        "operationId": "get_emi_options",
        "parameters": [
          {
            "name": "x-session-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
