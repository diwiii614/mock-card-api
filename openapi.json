    "/cards/{card_id}/block": {
      "post": {
        "tags": [
          "Protective"
        ],
        "summary": "Block a card permanently",
        "description": "Use immediately when the customer reports the card lost, stolen, or used fraudulently. Runs on session authentication so it is never delayed. This cannot be reversed by the coworker: a blocked card can only be replaced, not reactivated. Call get_card_status first to avoid blocking twice. Accepts the card_id from get_cards, for example CARD1001, or the last four digits of the card number.",
        "operationId": "block_card",
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Card Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlockRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
