    "/cards/{card_id}/pin-reset": {
      "post": {
        "tags": [
          "PIN"
        ],
        "summary": "Start an OTP verified PIN reset",
        "description": "Use when the customer wants to change their PIN, after a step up OTP. This only starts the process: it returns a one time link the customer uses to set the PIN on the bank's own secure channel. The PIN is never sent to or received by this API. Do not wait for the customer to finish, end the task and check get_pin_reset_status on a later contact.",
