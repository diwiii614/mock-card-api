    "/cards/{card_id}/fraud-case": {
      "post": {
        "tags": [
          "Fraud"
        ],
        "summary": "Log a fraud case for analyst review",
        "description": "Use after the card has been blocked, the customer has identified the disputed transactions, and a step up OTP has been completed. Creates a case for a human fraud analyst. The coworker does not investigate or close cases. Returns a reference for the customer.",
        "operationId": "log_fraud_case",
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Card Id"
            }
          }
