{
  "openapi": "3.0.3",
  "info": {
    "title": "Mock Card Management API",
    "description": "Card servicing for one verified cardholder and their single card. Call identify_customer with the registered mobile number or customer ID: it sends a one time code and returns a verification_id starting with SES. Then call verify_otp with that verification_id and the code the customer reads back; it returns the card_id and the card state, and opens a session lasting 15 minutes. Every other operation needs the verification_id and returns 401 until this has been done.\n\nThis holds one customer's own account data only. It does not hold the bank's policies: fees, interest rates, how EMI works, delivery timelines, the maximum a limit may be set to, what a feature controls, dispute windows, and general explanations of why a payment was refused all come from the policy lookup skill, not from here.",
    "version": "5.0.0"
  },
  "paths": {
    "/auth/identify": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Look up a customer and send an OTP",
        "description": "Use at the very start of a conversation, once the customer has given a registered mobile number or customer ID. Sends an OTP and returns the number masked so the customer can confirm it is theirs. Returns no account data, so nothing is exposed before verification. Returns a verification_id starting with SES: pass that exact value to verify_otp, and then on every other call for the rest of the conversation.",
        "operationId": "identify_customer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdentifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentifyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify-otp": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Verify the OTP and get the customer's card",
        "description": "Use after the customer supplies the OTP they received. On success it returns the customer_id, the card_id, and whether the card is active or blocked, so no further lookup is needed to start work, and it unlocks that customer's data for 15 minutes. Keep the card_id for the rest of the conversation. Every other endpoint returns 401 until this has succeeded, so there is no way to read or change anything first.",
        "operationId": "verify_otp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyOtpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyOtpResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/customers/{customer_id}/address": {
      "get": {
        "tags": [
          "Reads"
        ],
        "summary": "Get the address on record",
        "description": "Use when arranging a replacement card or raising a ticket, so the address on file can be confirmed with the customer. Read only.",
        "operationId": "get_customer_address",
        "parameters": [
          {
            "name": "customer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Customer Id"
            }
          },
          {
            "name": "verification_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "A verified session from verify_otp",
              "title": "Verification Id"
            },
            "description": "A verified session from verify_otp"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{card_id}": {
      "get": {
        "tags": [
          "Reads"
        ],
        "summary": "Get everything about the card in one call",
        "description": "Use whenever the customer asks about their own card: its state, what they have spent, how much is left, the limits and features currently set on it, whether their PIN has been changed, their name and address on record, or their recent transactions. One call returns all of it, so a second read is not needed to answer a question about this customer. Read only. Call it again after any change rather than repeating figures from earlier in the conversation.\n\nThis returns the customer's own values only. It does not explain the bank's rules. Fees, interest rates, how EMI works, delivery timelines, the maximum a limit may be set to, what a feature controls, dispute windows, and why a payment is refused in general all come from the policy lookup skill, not from here. The emi_options field lists the tenures and rates available and nothing more; any question about how EMI works needs the policy lookup skill.",
        "operationId": "get_card",
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Card Id"
            }
          },
          {
            "name": "verification_id",
            "in": "query",
            "required": false,
            "schema": {
              "description": "The verified verification_id from verify_otp, starting with SES. Required. Never invent it.",
              "title": "Verification Id",
              "type": "string",
              "example": "SES4B7C1E90A2D6"
            },
            "description": "The verified verification_id from verify_otp, starting with SES. Required. Never invent it."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Changes"
        ],
        "summary": "Change spending limits and card features",
        "description": "Use to change limits, switch features such as contactless, online payments, international usage, or ATM withdrawals, or both at once, after the customer has confirmed the new values. Every limit must be greater than 0 and no more than the monthly limit. Send all the changes the customer asked for in one call. Only the fields supplied change.",
        "operationId": "update_card",
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Card Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCardRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{card_id}/block": {
      "post": {
        "tags": [
          "Changes"
        ],
        "summary": "Block the card permanently",
        "description": "Use when the customer reports the card lost, stolen, or used fraudulently. This cannot be reversed: a blocked card can only be replaced, not reactivated, so tell the customer that and get an explicit yes before calling this. Check the card state first to avoid blocking a card that is already blocked.",
        "operationId": "block_card",
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Card Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlockRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{card_id}/replacement": {
      "post": {
        "tags": [
          "Servicing"
        ],
        "summary": "Request a replacement card",
        "description": "Use once the reason is known and the customer has confirmed the delivery address. If the card was lost or stolen it must be blocked first. Returns a reference the customer can quote. The fee must be stated to the customer before they confirm, and comes from the policy lookup skill, not from this response.",
        "operationId": "request_replacement",
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Card Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplacementRequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{card_id}/pin-reset": {
      "post": {
        "tags": [
          "Servicing"
        ],
        "summary": "Send the customer a PIN change link",
        "description": "Use when the customer wants to change their PIN. Returns a one time link the customer opens themselves; the PIN is never sent to or received by this API. Give the customer the link and move on. To check whether they finished, call get_card and read the pin block: pin_changed turns true once they have opened the link.",
        "operationId": "initiate_pin_reset",
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Card Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PinResetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tickets": {
      "post": {
        "tags": [
          "Servicing"
        ],
        "summary": "Raise a support ticket",
        "description": "Use when the customer reports something that cannot be resolved here, such as a transaction they do not recognise, or a complaint. Confirm the name and address with the customer first, both are in get_card and get_customer_address. Returns a reference number to give them. Do not speculate about the outcome or promise a refund.",
        "operationId": "raise_ticket",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Servicing"
        ],
        "summary": "List this customer's tickets",
        "description": "Use when the customer asks what has been raised for them, or before raising a new ticket so the same issue is not logged twice. Returns every ticket for the verified customer, newest first. Read only.",
        "operationId": "list_tickets",
        "parameters": [
          {
            "name": "verification_id",
            "in": "query",
            "required": false,
            "schema": {
              "description": "The verified verification_id from verify_otp, starting with SES. Required. Never invent it.",
              "title": "Verification Id",
              "type": "string",
              "example": "SES4B7C1E90A2D6"
            },
            "description": "The verified verification_id from verify_otp, starting with SES. Required. Never invent it."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tickets/{reference}": {
      "get": {
        "tags": [
          "Servicing"
        ],
        "summary": "Check the status of a ticket",
        "description": "Use when the customer quotes a ticket number and asks where it has got to. Returns the current state and the history of what has happened to it. Report the state as returned and do not speculate about the outcome. Read only.",
        "operationId": "get_ticket",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Reference"
            }
          },
          {
            "name": "verification_id",
            "in": "query",
            "required": false,
            "schema": {
              "description": "The verified verification_id from verify_otp, starting with SES. Required. Never invent it.",
              "title": "Verification Id",
              "type": "string",
              "example": "SES4B7C1E90A2D6"
            },
            "description": "The verified verification_id from verify_otp, starting with SES. Required. Never invent it."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Testing"
        ],
        "summary": "Check the service is up",
        "description": "Returns the service status and how many customers exist. Use it to confirm the connection works, or to wake a sleeping instance. Returns no customer data.",
        "operationId": "health_check",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BlockReason": {
        "type": "string",
        "enum": [
          "lost",
          "stolen",
          "fraud",
          "damaged"
        ],
        "title": "BlockReason"
      },
      "BlockRequest": {
        "properties": {
          "verification_id": {
            "type": "string",
            "title": "Verification Id",
            "description": "Copy the verification_id string exactly as it appeared in the identify_customer response. Do not construct it or build it from any other value.",
            "example": "SES4B7C1E90A2D6"
          },
          "reason": {
            "$ref": "#/components/schemas/BlockReason"
          }
        },
        "type": "object",
        "required": [
          "verification_id",
          "reason"
        ],
        "title": "BlockRequest"
      },
      "CardState": {
        "type": "string",
        "enum": [
          "active",
          "blocked"
        ],
        "title": "CardState"
      },
      "FeaturesPayload": {
        "properties": {
          "contactless": {
            "title": "Contactless",
            "type": "boolean"
          },
          "online_payments": {
            "title": "Online Payments",
            "type": "boolean"
          },
          "international_usage": {
            "title": "International Usage",
            "type": "boolean"
          },
          "atm_withdrawals": {
            "title": "Atm Withdrawals",
            "type": "boolean"
          }
        },
        "type": "object",
        "title": "FeaturesPayload"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IdentifyRequest": {
        "properties": {
          "identifier": {
            "type": "string",
            "title": "Identifier",
            "description": "Registered mobile number or customer ID",
            "example": "9000000000"
          }
        },
        "type": "object",
        "required": [
          "identifier"
        ],
        "title": "IdentifyRequest"
      },
      "IdentifyResponse": {
        "properties": {
          "verification_id": {
            "type": "string",
            "title": "Verification Id",
            "description": "Issued by this API. Copy this exact string and pass it to verify_otp, then on every other call for the rest of the conversation.",
            "example": "SES4B7C1E90A2D6"
          },
          "otp_sent": {
            "type": "boolean",
            "title": "Otp Sent"
          },
          "masked_mobile": {
            "type": "string",
            "title": "Masked Mobile",
            "description": "For the customer to confirm it is theirs"
          },
          "otp_valid_for_minutes": {
            "type": "integer",
            "title": "Otp Valid For Minutes"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "verification_id",
          "otp_sent",
          "masked_mobile",
          "otp_valid_for_minutes",
          "message"
        ],
        "title": "IdentifyResponse"
      },
      "LimitsPayload": {
        "properties": {
          "atm": {
            "title": "Atm",
            "type": "integer",
            "maximum": 100000,
            "exclusiveMinimum": 0
          },
          "pos": {
            "title": "Pos",
            "type": "integer",
            "maximum": 100000,
            "exclusiveMinimum": 0
          },
          "online": {
            "title": "Online",
            "type": "integer",
            "maximum": 100000,
            "exclusiveMinimum": 0
          },
          "international": {
            "title": "International",
            "type": "integer",
            "maximum": 100000,
            "exclusiveMinimum": 0
          }
        },
        "type": "object",
        "title": "LimitsPayload"
      },
      "PinResetRequest": {
        "properties": {
          "verification_id": {
            "type": "string",
            "title": "Verification Id",
            "description": "Copy the verification_id string exactly as it appeared in the identify_customer response. Do not construct it or build it from any other value.",
            "example": "SES4B7C1E90A2D6"
          }
        },
        "type": "object",
        "required": [
          "verification_id"
        ],
        "title": "PinResetRequest"
      },
      "ReplacementReason": {
        "type": "string",
        "enum": [
          "lost_or_stolen",
          "damaged"
        ],
        "title": "ReplacementReason"
      },
      "ReplacementRequestBody": {
        "properties": {
          "verification_id": {
            "type": "string",
            "title": "Verification Id",
            "description": "Copy the verification_id string exactly as it appeared in the identify_customer response. Do not construct it or build it from any other value.",
            "example": "SES4B7C1E90A2D6"
          },
          "reason": {
            "$ref": "#/components/schemas/ReplacementReason"
          },
          "delivery_address": {
            "type": "string",
            "title": "Delivery Address",
            "description": "Confirmed with the customer first"
          }
        },
        "type": "object",
        "required": [
          "verification_id",
          "reason",
          "delivery_address"
        ],
        "title": "ReplacementRequestBody"
      },
      "TicketRequest": {
        "properties": {
          "verification_id": {
            "type": "string",
            "title": "Verification Id",
            "description": "Copy the verification_id string exactly as it appeared in the identify_customer response. Do not construct it or build it from any other value.",
            "example": "SES4B7C1E90A2D6"
          },
          "card_id": {
            "type": "string",
            "title": "Card Id",
            "description": "The verified customer's card",
            "example": "CARD0000"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "example": "Jane Doe"
          },
          "address": {
            "type": "string",
            "title": "Address",
            "example": "1 Example Street, City, State 000000"
          },
          "issue": {
            "type": "string",
            "title": "Issue",
            "description": "What the customer is reporting",
            "example": "Does not recognise a transaction on the statement"
          }
        },
        "type": "object",
        "required": [
          "verification_id",
          "card_id",
          "name",
          "address",
          "issue"
        ],
        "title": "TicketRequest"
      },
      "UpdateCardRequest": {
        "properties": {
          "verification_id": {
            "type": "string",
            "title": "Verification Id",
            "description": "Copy the verification_id string exactly as it appeared in the identify_customer response. Do not construct it or build it from any other value.",
            "example": "SES4B7C1E90A2D6"
          },
          "limits": {
            "description": "Only the limits supplied are changed",
            "$ref": "#/components/schemas/LimitsPayload"
          },
          "features": {
            "description": "Only the features supplied are changed",
            "$ref": "#/components/schemas/FeaturesPayload"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "verification_id"
        ],
        "title": "UpdateCardRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerifyOtpRequest": {
        "properties": {
          "verification_id": {
            "title": "Verification Id",
            "description": "The exact value returned by identify_customer, starting with SES. Never invent it.",
            "type": "string",
            "example": "SES4B7C1E90A2D6"
          },
          "otp": {
            "type": "string",
            "title": "Otp",
            "example": "123456"
          }
        },
        "type": "object",
        "required": [
          "otp"
        ],
        "title": "VerifyOtpRequest"
      },
      "VerifyOtpResponse": {
        "properties": {
          "verified": {
            "type": "boolean",
            "title": "Verified"
          },
          "verification_id": {
            "type": "string",
            "title": "Verification Id"
          },
          "attempts_remaining": {
            "title": "Attempts Remaining",
            "type": "integer"
          },
